{
    "python.terminal.activateEnvironment": false,
    "terminal.integrated.profiles.linux": {
        "bash-proj": {
            "path": "bash",
            "args": ["--rcfile", ".vscode/proj.bashrc"],
            "overrideName": true,
            "icon": "terminal-bash",
            "color": "terminal.ansiGreen",
            "env": {}
        }
